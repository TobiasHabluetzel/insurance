# Insurance.Claim — MVC frontend (wizard + bot + evidence). Reverse-proxies
# /api/* to Insurance.Api via YARP.

FROM node:20-alpine AS styles
WORKDIR /app
COPY src/Insurance.Claim/package*.json ./
RUN npm ci
COPY src/Insurance.Claim/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS backend
WORKDIR /src
COPY src/Insurance.Claim/Insurance.Claim.csproj ./
RUN dotnet restore
COPY src/Insurance.Claim/ ./
COPY --from=styles /app/wwwroot/css/site.css wwwroot/css/site.css
RUN dotnet publish -c Release -o /publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=backend /publish .
EXPOSE 8080
CMD ["sh", "-c", "ASPNETCORE_HTTP_PORTS=${PORT:-8080} dotnet Insurance.Claim.dll"]
