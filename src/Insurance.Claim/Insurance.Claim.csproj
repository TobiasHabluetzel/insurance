<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reverse-proxies /api/* to Insurance.Api so the browser sees a
         single origin. Handles SSE + multipart streaming natively —
         ClaimSubmittedPage's EventSource and document uploads pass
         through unchanged. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

</Project>
