@model System.Text.Json.Nodes.JsonNode
@{
    ViewData["Title"] = "File Claim";
    var policyJson = Model.ToJsonString();
    var mapsKey = ViewData["GoogleMapsApiKey"] as string ?? "";
}

@await Html.PartialAsync("_BrandHeader")

@* The whole page runs inside FileClaimController — form state lives in
   $scope, submit talks to /api/claimwizard via policySvc. *@
<main ng-controller="FileClaimController" class="flex flex-col flex-1 bg-gray-50">

    <div class="text-white text-center py-4 px-4 bg-brand-purple">
        <p class="text-xs font-semibold tracking-widest uppercase mb-1 text-brand-purple-muted">Emergency</p>
        <p class="font-semibold text-base flex items-center justify-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z" />
            </svg>
            Call us on <a href="tel:+31182544555" class="underline">+31 182 544 555</a>
        </p>
    </div>

    <div class="flex-1 px-4 py-5 space-y-5 max-w-lg mx-auto w-full">
        <h1 class="text-gray-800 font-bold text-xl px-1">File Claim</h1>

        <div class="space-y-2">
            <label class="flex items-center gap-1 px-1">
                <span class="text-brand-blue font-semibold">Who</span>
                <span class="text-gray-600">is affected?</span>
            </label>
            <insured-dropdown
                insureds="policy.insured"
                selected-uid="selectedInsuredUid"
                on-change="handleInsuredChange(insured)"></insured-dropdown>
        </div>

        <div class="space-y-2">
            <label class="flex items-center gap-1 px-1">
                <span class="text-brand-blue font-semibold">When</span>
                <span class="text-gray-600">did it happen?</span>
            </label>
            <date-picker
                value="incidentDate"
                min-date="periodStart"
                max-date="maxDate"
                on-change="handleDateChange(date)"></date-picker>
        </div>

        <div class="space-y-2">
            <label class="flex items-center gap-1 px-1">
                <span class="text-brand-blue font-semibold">Where</span>
                <span class="text-gray-600">did it happen?</span>
            </label>
            <address-picker
                api-key="{{ googleMapsApiKey }}"
                initial-address="address"
                on-change="handleAddressChange(address)"></address-picker>
        </div>

        <div class="space-y-2">
            <label class="flex items-center gap-1 px-1">
                <span class="text-brand-blue font-semibold">What</span>
                <span class="text-gray-600">did it happen?</span>
            </label>
            <document-upload
                files="documents"
                on-change="handleDocumentsChange(files)"></document-upload>
        </div>

        <div ng-if="error" class="text-red-500 text-sm bg-red-50 px-4 py-3 rounded-xl">
            {{ error }}
        </div>

        <div class="pt-2">
            <button ng-click="submit()" ng-disabled="!canContinue()"
                    class="bg-brand-purple text-white rounded-full px-8 py-4 font-semibold flex items-center gap-3 disabled:opacity-40 transition-opacity">
                <span ng-if="!submitting">Continue</span>
                <span ng-if="submitting">Submitting…</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </button>
        </div>
    </div>
</main>

@section Scripts {
    @* Hand the policy JSON + maps key to the AngularJS controller.
       Html.Raw is safe here — ToJsonString on JsonNode produces valid JSON
       with no HTML injection surface; the API key is a plain string that
       we JSON-encode below. *@
    <script>
        window.__initialPolicy = @Html.Raw(policyJson);
        window.__googleMapsApiKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapsKey));
    </script>
    <script src="~/app/directives/insuredDropdown.js" asp-append-version="true"></script>
    <script src="~/app/directives/datePicker.js" asp-append-version="true"></script>
    <script src="~/app/directives/addressPicker.js" asp-append-version="true"></script>
    <script src="~/app/directives/documentUpload.js" asp-append-version="true"></script>
    <script src="~/app/controllers/fileClaimController.js" asp-append-version="true"></script>
}
