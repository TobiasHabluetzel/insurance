# Insurance.Api — pure .NET web API, no static assets.
# One Railway service points at this Dockerfile.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/Insurance.Api/Insurance.Api.csproj ./
RUN dotnet restore
COPY src/Insurance.Api/ ./
RUN dotnet publish -c Release -o /publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /publish .
EXPOSE 8080
CMD ["sh", "-c", "ASPNETCORE_HTTP_PORTS=${PORT:-8080} dotnet Insurance.Api.dll"]
