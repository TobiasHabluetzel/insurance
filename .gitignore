# .NET build output
bin/
obj/
*.user

# Node — Tailwind CLI is run inside the Docker build, node_modules stays local
node_modules/
npm-debug.log*

# IDE
.vs/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Compiled Tailwind — regenerated on every build via `npm run build`
src/*/wwwroot/css/site.css

# Env files that might contain secrets
*.env
.env.local

# Word lock files, created while a .docx is open
~$*
